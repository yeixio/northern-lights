# Copy to .env and adjust. Every setting is optional.

# Port the server listens on.
PORT=3000

# Where the SQLite database and uploads live by default.
DATA_DIR=./data

# Database. Leave unset for SQLite at $DATA_DIR/northern-lights.db, or use:
#   DATABASE_URL=sqlite:/srv/northern-lights/site.db
#   DATABASE_URL=postgres://user:password@localhost:5432/northern_lights
# DATABASE_URL=

# Public URL of your site. Used in invite and reset links. Setting an https://
# URL also marks the login cookie Secure.
# APP_URL=https://family.example.com

# Email (optional). Without it, invite and reset links are shown on screen for
# you to send yourself. Admins can also set up email in the app, under
# Admin > Site settings; SMTP_URL wins when both are set.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="Northern Lights <no-reply@example.com>"

# Uploaded photos and videos: "local" (default, saved under $DATA_DIR/uploads)
# or "s3" for any S3-compatible service (AWS, Backblaze B2, Cloudflare R2, MinIO).
# STORAGE=local
# MAX_UPLOAD_MB=50
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# Hosted sites (for a host running many sites, like yeix.io/hosting).
# SETUP_TOKEN: only the setup link /setup?token=<SETUP_TOKEN> can create the
#   first admin, so nobody else can claim a new site.
# STORAGE_QUOTA_MB: total size of all uploads; uploads stop when it's reached.
# READ_ONLY=true: people can sign in and look, but not post or change anything.
# S3_PREFIX: a folder for this site's files when sites share a bucket, e.g. smith-family/
# SETUP_TOKEN=
# STORAGE_QUOTA_MB=5120
# READ_ONLY=false
# S3_PREFIX=
