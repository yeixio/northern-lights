{
  "name": "northern-lights",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A self-hosted personal social site: a public page for you, your family, or your group, plus a private, invite-only social network. Runs on SQLite or Postgres.",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "dev:hub": "vite --config vite.hub.config.ts",
    "build": "tsc -b && vite build && tsc -p server/tsconfig.json",
    "build:hub": "vite build --config vite.hub.config.ts",
    "start": "node dist/server/index.js",
    "test": "tsx --test server/app.test.ts src/lib/facebook.test.ts src/hub/merge.test.ts src/hub/links.test.ts",
    "typecheck": "tsc -b && tsc -p server/tsconfig.json --noEmit && tsc -p scripts/tsconfig.json",
    "demo": "npm run build && tsx scripts/demo/seed.ts --serve",
    "demo:seed": "tsx scripts/demo/seed.ts",
    "screenshots": "tsx scripts/demo/screenshots.ts",
    "store:screenshots": "tsx scripts/demo/store-screenshots.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1157.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@hono/node-server": "^2.1.5",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.14",
    "kysely": "^0.29.7",
    "lucide-react": "^1.61.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~7.0",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22"
  }
}
