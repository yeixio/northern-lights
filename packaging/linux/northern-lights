#!/bin/sh
# Starts the Northern Lights server with the Node.js runtime bundled in this package.
# Settings come from /etc/northern-lights/northern-lights.env unless ENV_FILE says otherwise.
export NODE_ENV="${NODE_ENV:-production}"
export ENV_FILE="${ENV_FILE:-/etc/northern-lights/northern-lights.env}"
export CLIENT_DIR="${CLIENT_DIR:-/usr/lib/northern-lights/dist/client}"
exec /usr/lib/northern-lights/node/bin/node /usr/lib/northern-lights/dist/server/index.js "$@"
