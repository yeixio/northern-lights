{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "outDir": "../dist/server",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["."],
  "exclude": ["**/*.test.ts"]
}
